# =============================================================================
# Variables de PRODUCCIÓN para docker-compose.prod.yml.
# En Coolify / Dokploy se copian en la sección "Environment Variables" del proyecto.
# En un despliegue manual: copiar a .env.production (está en .gitignore) y llenar.
# NUNCA subas este archivo con valores reales al repositorio.
# =============================================================================

APP_NAME=Amerishop
# Generar UNA vez: docker compose exec app php artisan key:generate --show (en local)
# y no cambiarla después: cifra las contraseñas de las cuentas de correo del panel.
APP_KEY=
# Dirección pública con https (también es la base de GOOGLE_REDIRECT_URI)
APP_URL=https://tu-dominio.com

# Base de datos: inventa contraseñas largas (no "root")
DB_DATABASE=tienda_ropa
DB_USERNAME=tienda
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Correo del servidor (respaldo si no hay cuenta en uso en el panel /admin/correo)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Contraseña de aplicación de Google (16 letras, sin espacios)
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Amerishop

# Login con Google (Google Cloud Console > Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tu-dominio.com/auth/google/callback

# Notificaciones push: usa las mismas claves que en local (si las cambias, los
# dispositivos suscritos dejan de recibir avisos). Generar nuevas: php artisan webpush:vapid
VAPID_SUBJECT=mailto:tu-correo@gmail.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Data warehouse y bitácora (rama app-movil). Usuario de MySQL con solo SELECT e INSERT.
# Después del primer despliegue, crearlo UNA vez (ver docs/DATA-WAREHOUSE.md).
DW_DB_DATABASE=tienda_dw
DW_DB_USERNAME=tienda_dw
DW_DB_PASSWORD=
